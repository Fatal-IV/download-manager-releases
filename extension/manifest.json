{
  "manifest_version": 3,
  "name": "İndirme Yöneticisi Entegrasyonu",
  "version": "0.2.0",
  "description": "Tarayıcı indirmelerini İndirme Yöneticisi uygulamasına yönlendirir.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["downloads", "cookies", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:38653/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "İndirme Yöneticisi",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  }
}
